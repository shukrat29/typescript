{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "strict": true,
    "rootDir": ".", // Your source is everything under /typescript
    "outDir": "./dist", // Output JS will go into /typescript/dist/
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*.ts"],
  "exclude": ["dist"]
}
